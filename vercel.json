{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/session.js", "use": "@vercel/node", "config": { "includeFiles": ["data/posts.json"] } },
    { "src": "api/event.js", "use": "@vercel/node" },
    { "src": "api/response.js", "use": "@vercel/node" },
    { "src": "api/export.js", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    { "src": "/api/session", "dest": "/api/session.js" },
    { "src": "/api/event", "dest": "/api/event.js" },
    { "src": "/api/response", "dest": "/api/response.js" },
    { "src": "/api/export", "dest": "/api/export.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
